includes:
    - vendor/actra/coding-standard/config/phpstan.neon
    # Only for legacy code, may only shrink
    - phpstan-baseline.neon

parameters:
    phpVersion: 80500
    paths:
        - src
        - tests
        - example/app
        - example/public
    excludePaths:
        # Generated phone number metadata arrays
        - src/phone/data
        # Template cache generated by the example at runtime
        - example/app/cache (?)
