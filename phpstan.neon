includes:
    - vendor/actra/coding-standard/config/phpstan.neon
    - vendor/actra/coding-standard/config/phpstan-no-superglobals.neon
    # Only for legacy code, may only shrink
    - phpstan-baseline.neon

parameters:
    actraSuperglobalsAllowIn:
        - src/Core.php
        - src/core/HttpRequest.php
        - src/session/NativeSessionStorage.php
        - src/session/AbstractSessionHandler.php
        # Tests that prepare or inspect superglobals
        - tests/Double/api/echo-server.php
        - tests/Double/api/scripted-server.php
        - tests/Unit/CoreTest.php
        - tests/Unit/common/SearchStateRequestTest.php
        - tests/Unit/core/HttpRequestFromGlobalsTest.php
        - tests/Unit/core/HttpRequestGetallheadersTest.php
        - tests/Unit/session/AbstractSessionHandlerTest.php
        - tests/Unit/session/NativeSessionStorageTest.php
    phpVersion: 80500
    paths:
        - src
        - tests
        - example/app
        - example/public
    excludePaths:
        # Generated phone number metadata arrays
        - src/phone/data
        # Template cache generated by the example at runtime
        - example/app/cache (?)
