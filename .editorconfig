# Actra coding standard: https://github.com/Actra-AG/coding-standard
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# PHP and its tool configuration: 4 spaces (PER Coding Style)
[*.{php,neon}]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
